outputformats = HTML

language = Cpp
codelanguages =

headers.fileextensions = "*.ch *.h *.h++ *.hh *.hpp *.hxx"
sources.fileextensions = "*.c++ *.cc *.cpp *.cxx *.mm *.qml *.qdoc"

codeindent = 0
tabsize = 8

includeprivate = false
showautogenerateddocs = true

warnaboutmissingimages = true
warnaboutmissingprojectfiles = true

preliminary = Preliminary
preliminary.description = "This \1 is under development and is subject to change."

locationinfo = true
falsehoods = 0
