# User module: documents class Local and non-members related to Local,
# with additional \relates commands that target classes in the target
# module. The non-members are documented on the reference page for Local,
# and the index file records the additional targets.

project = RelatesUser
productname = Qt

locationinfo = false

headers.fileextensions = "*.h"
sources.fileextensions = "*.cpp *.qdoc"

sourcedirs = ./src/user
headerdirs = ./src/user

depends = relatestarget

outputformats = HTML

HTML.nosubdirs = true
HTML.outputsubdir = html

warninglimit = 0
warninglimit.enabled = true
