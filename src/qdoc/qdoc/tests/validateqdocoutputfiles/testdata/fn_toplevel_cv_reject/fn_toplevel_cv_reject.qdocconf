project = FnTopLevelCvReject
outputformats = HTML WebXML DocBook
HTML.nosubdirs = true
HTML.outputsubdir = html
WebXML.nosubdirs = true
WebXML.outputsubdir = webxml
DocBook.nosubdirs = true
DocBook.outputsubdir = docbook
locationinfo = false
headerdirs = src
sourcedirs = src
documentationinheaders = false
# Rejection requires both nonattachment and one warning per command.
warninglimit = 4
warninglimit.enabled = true
projectroot = .
logwarnings = true
logwarnings.disablecliargs = true
