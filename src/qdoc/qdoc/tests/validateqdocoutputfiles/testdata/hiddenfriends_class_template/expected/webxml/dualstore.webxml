            <function name="dualCheck" href="dualstore.html#dualCheck" status="active" access="public" location="dual.h" documented="true" related="1" meta="plain" hidden-friend="true" noexcept="true" type="void" signature="void dualCheck(DualStore&lt;Lhs, Rhs&gt; &amp;a, Lhs key)">
