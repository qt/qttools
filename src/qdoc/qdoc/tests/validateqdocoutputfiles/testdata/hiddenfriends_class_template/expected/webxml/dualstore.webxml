        <class name="DualStore" href="dualstore.html" status="active" access="public" location="dual.h" documented="true" includefile="dual.h" module="HiddenFriendsClassTemplate" brief="A two-type-parameter template class with an asymmetric hidden friend">
            <description>
                <brief>A two-type-parameter template class with an asymmetric hidden friend.</brief>
                <para>The <argument>Lhs</argument> and <argument>Rhs</argument> parameters specify the key and value types.</para>
