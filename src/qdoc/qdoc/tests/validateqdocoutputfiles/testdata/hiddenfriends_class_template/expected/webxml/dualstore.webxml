                <parameter type="Lhs" name="key" default=""/>
                <description>
                    <para>Checks <argument>a</argument> using <argument>key</argument>. Dual parameter marker. The documentation renames the template parameters and repeats the correct argument bindings.</para>
                </description>
            </function>
        </class>
