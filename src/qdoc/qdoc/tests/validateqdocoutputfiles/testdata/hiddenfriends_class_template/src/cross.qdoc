/*!
    \class CrossThing
    \inmodule HiddenFriendsClassTemplate
    \brief A template class whose hidden friend documentation is related to CrossTarget.

    The \a T parameter specifies the element type.
*/

/*!
    \class CrossTarget
    \inmodule HiddenFriendsClassTemplate
    \brief A non-template class that hosts the crossCheck documentation.
*/

/*!
    \fn template <typename T> void crossCheck(CrossThing<T> &a, CrossThing<T> &b) noexcept
    \relates CrossTarget

    Checks \a a against \a b. Cross-target relates marker.
*/
