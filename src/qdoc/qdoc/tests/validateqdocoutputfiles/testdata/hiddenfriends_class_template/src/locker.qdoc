/*!
    \module HiddenFriendsClassTemplate
    \brief Module for class-template hidden-friend resolution tests.
*/

/*!
    \class PlainLocker
    \inmodule HiddenFriendsClassTemplate
    \brief A minimal locker template.

    The \a Mutex parameter specifies the mutex type.
*/

/*!
    \fn template <typename Mutex> void swap(PlainLocker<Mutex> &lhs, PlainLocker<Mutex> &rhs) noexcept

    Swaps \a lhs and \a rhs. Out-of-line hidden-friend resolution marker.
*/
