/*!
    \namespace locker_ns
    \inmodule HiddenFriendsClassTemplate
    \brief A namespace containing a class template with a hidden friend.
*/

/*!
    \class locker_ns::NamespaceLocker
    \inmodule HiddenFriendsClassTemplate
    \brief A template class inside a namespace.

    The \a Mutex parameter specifies the mutex type.
*/

/*!
    \fn template <typename Mutex> void namespaceSwap(locker_ns::NamespaceLocker<Mutex> &lhs, locker_ns::NamespaceLocker<Mutex> &rhs) noexcept

    Swaps \a lhs and \a rhs. Namespace hidden-friend resolution marker.
*/
