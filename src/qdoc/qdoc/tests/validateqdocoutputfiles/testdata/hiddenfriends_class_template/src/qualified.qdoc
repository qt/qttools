/*!
    \class QualLocker
    \inmodule HiddenFriendsClassTemplate
    \brief A template class whose hidden friend is documented with class-qualified syntax.

    The \a Mutex parameter specifies the mutex type.
*/

/*!
    \fn template <typename Mutex> void QualLocker<Mutex>::qswap(QualLocker<Mutex> &lhs, QualLocker<Mutex> &rhs) noexcept

    Swaps \a lhs and \a rhs. Class-qualified hidden-friend marker.
*/
