/*!
    \class RenamedThing
    \inmodule HiddenFriendsClassTemplate
    \brief A template class whose template parameter is renamed in the documentation.

    The \a T parameter specifies the element type.
*/

/*!
    \fn template <typename U> void resetThing(RenamedThing<U> &lhs) noexcept

    Resets \a lhs. Renamed template parameter marker.
*/
