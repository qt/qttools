/*!
    \page list-comment-argument-test.html
    \title List Comment Argument Test

    This page verifies that a \c{//!} comment placed between \\list and its
    first \\li is not mistaken for the optional list-style argument.

    \list
    //! Comment
    \li First item
    \li Second item
    \endlist
*/
