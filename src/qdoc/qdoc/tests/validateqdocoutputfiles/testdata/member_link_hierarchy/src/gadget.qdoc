/*!
    \qmlmodule MemberLinksQml
    \title Member Links QML Types
    \brief Tests links in QML member documentation that also match global keywords.
*/

/*!
    \qmltype Gadget
    \inqmlmodule MemberLinksQml
    \brief A QML type.

    The type body links to \l size.
*/

/*!
    \qmlproperty int Gadget::size

    The size of the gadget.
*/

/*!
    \qmlproperty int Gadget::capacity

    The capacity of the gadget, never larger than \l size.
*/

/*!
    \qmlmethod void Gadget::resize()

    Changes \l size.
*/
