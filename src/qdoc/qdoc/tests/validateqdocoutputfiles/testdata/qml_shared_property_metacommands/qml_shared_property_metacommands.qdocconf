project = SharedPropertyMetacommands
locationinfo = false
# One "Ignored '\overload'" warning per documented property.
warninglimit = 4
warninglimit.enabled = true

moduleheader =
sourcedirs = src
sources.fileextensions = "*.qdoc"

outputformats = HTML
HTML.nosubdirs = true
HTML.outputsubdir = html
