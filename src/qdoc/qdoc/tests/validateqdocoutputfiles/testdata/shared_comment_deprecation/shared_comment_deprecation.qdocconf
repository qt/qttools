project = SharedCommentDeprecation
version = 6.8
locationinfo = false
warninglimit = 0
warninglimit.enabled = true

moduleheader =
sourcedirs = src
sources.fileextensions = "*.qdoc"

outputformats = HTML DocBook
{HTML.nosubdirs,DocBook.nosubdirs} = true
HTML.outputsubdir = html
DocBook.outputsubdir = docbook
