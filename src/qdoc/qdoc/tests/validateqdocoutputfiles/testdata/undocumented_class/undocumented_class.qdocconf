project = Undocumented class with documented members
moduleheader = class.h
{includepaths,headerdirs,sourcedirs} = src

locationinfo = false

# This project generates warnings and no .html output:
# one for each explicitly documented member of an undocumented class.
projectroot = .
logwarnings = true
logwarnings.disablecliargs = true
warninglimit = 4
warninglimit.enabled = true
