<WebXML>
    <document>
        <struct name="AxisAndAngle" href="axisandangle.html" status="active" access="public" location="templatestruct.h" documented="true" module="UnnamedStructModule">
            <description>
                <para>Test struct similar to QQuaternion::AxisAndAngle to reproduce the bug. Contains multiple anonymous types to force Clang path-based naming.</para>
            </description>
            <variable name="axis" fullname="AxisAndAngle::axis" href="axisandangle.html#axis-var" status="active" access="public" location="templatestruct.h" documented="true" type="struct AxisAndAngle&lt;AngleT&gt;::(unnamed struct)" static="false">
                <description>
                    <para>The 3D axis that together with an angle corresponds to a quaternion.</para>
                    <para>An unnamed struct containing members x, y, z.</para>
                </description>
            </variable>
            <variable name="rotationCache" fullname="AxisAndAngle::rotationCache" href="axisandangle.html#rotationCache-var" status="active" access="public" location="templatestruct.h" documented="true" type="struct AxisAndAngle&lt;AngleT&gt;::(unnamed struct)" static="false">
                <description>
                    <para>Cached rotation data with multiple anonymous types to trigger disambiguation.</para>
                </description>
            </variable>
            <variable name="transformationMatrix" fullname="AxisAndAngle::transformationMatrix" href="axisandangle.html#transformationMatrix-var" status="active" access="public" location="templatestruct.h" documented="true" type="union AxisAndAngle&lt;AngleT&gt;::(unnamed union)" static="false">
                <description>
                    <para>Complex nested anonymous types similar to Qt's real patterns.</para>
                </description>
            </variable>
        </struct>
