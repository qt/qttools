project = ComparisonTable
description = Test fixture for comparison tables in template output
productname = Qt

version = 6.12

locationinfo = false

headers.fileextensions  = "*.h"
sources.fileextensions  = "*.cpp"

documentationinheaders = true

headerdirs  = src
sourcedirs  = src

outputformats = TemplateHTML TemplateMarkdown

TemplateHTML.nosubdirs = true
TemplateHTML.outputsubdir = html
TemplateHTML.extension = html
TemplateHTML.stylesheet = false

TemplateMarkdown.nosubdirs = true
TemplateMarkdown.outputsubdir = markdown
TemplateMarkdown.extension = md

# Fail the run on any warning; the fixture is expected to be clean.
warninglimit = 0
warninglimit.enabled = true

