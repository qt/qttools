/*!
    \qmlmodule DeprecationNotes
    \title Deprecation Notes QML Types
    \brief Types covering the deprecation status sentence cases.
*/

/*!
    \qmltype OldGadget
    \inqmlmodule DeprecationNotes
    \brief A QML type that was deprecated in 6.5.
    \deprecated [6.5]
*/

/*!
    \qmltype PendingGadget
    \inqmlmodule DeprecationNotes
    \brief A QML type scheduled for deprecation in 6.66.
    \deprecated [6.66]

    The type remains fully functional until 6.66.
*/

/*!
    \qmlmethod void PendingGadget::update()
    \brief An operation scheduled for deprecation in 6.66.
    \deprecated [6.66]

    The operation that new QML code should stop calling.
*/

/*!
    \qmltype LegacyGadget
    \inqmlmodule DeprecationNotes
    \brief A QML type deprecated without a version.
    \deprecated

    The type still works, but new code should avoid it.
*/

/*!
    \qmltype NewGadget
    \inqmlmodule DeprecationNotes
    \brief A QML type with deprecated and scheduled members.
*/

/*!
    \qmltype InternalBase
    \inqmlmodule DeprecationNotes
    \qmlabstract
    \internal
    \brief An internal abstract base with a deprecated property.
*/

/*!
    \qmlproperty int InternalBase::retired
    \brief An inherited deprecated property.
    \deprecated [6.5]

    Inherited property body.
*/

/*!
    \qmltype OnlyInherited
    \inqmlmodule DeprecationNotes
    \inherits InternalBase
    \brief A concrete type whose only deprecated members are inherited.
*/

/*!
    \qmlmethod void NewGadget::close()
    \brief Closes the gadget.
    \deprecated [6.5]
*/

/*!
    \qmlproperty string NewGadget::serialNumber
    \brief The gadget serial number.
    \deprecated [6.5]

    The serial number the gadget reports. New code should use the
    platform-assigned identifier instead.
*/

/*!
    \qmlsignal void NewGadget::broke()
    \brief Emitted when the gadget breaks.
    \deprecated [6.10]

    Notifies listeners that the gadget broke. New code should track the
    status property instead.
*/

/*!
    \qmlproperty int NewGadget::level
    \brief The gadget level.
    \deprecated [6.66]
*/
