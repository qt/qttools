project = A minimal template QDoc configuration
productname = Qt

locationinfo = false

headers.fileextensions  = "*.h *.hpp"
sources.fileextensions  = "*.cpp *.qml *.qdoc"

headerdirs  = ./src
sourcedirs  = ./src

outputformats = template
template.nosubdirs = true
template.outputsubdir = template

warninglimit = 0
warninglimit.enabled = true

