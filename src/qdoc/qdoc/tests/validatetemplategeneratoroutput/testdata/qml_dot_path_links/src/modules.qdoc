/*!
    \qmlmodule TestModule 1.0
    \title Test Module
    \brief A QML module with a layout type and a page.

    The module documents QML dot-path links from a QML type body and
    from a plain page. See the \l Layout type page for the links.
*/

/*!
    \qmlmodule OtherModule 1.0
    \title Other Module
    \brief A QML module whose type names compete with TestModule's.

    Its \l OtherModule.Layout type has the same name as TestModule's
    Layout type, but different members.
*/
