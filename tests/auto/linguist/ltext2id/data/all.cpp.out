class Dialog2
{
    Q_OBJECT
    void func();
    void func3();
    int getCount() const { return 2; }
};

void Dialog2::func()
{
    int n = getCount();
    //% "%n files"
    //@ Dialog2
    qtTrId("Dialog2-fna-27205" , n);
    //% "%n cars"
    //@ Dialog2
    qtTrId("Dialog2-fna-69328" , n);
    //% "&Find %n cars"
    //@ Dialog2
    qtTrId("Dialog2-gFindaf-5548" , n);
    //% "Search in %n items?"
    //@ Dialog2
    qtTrId("Dialog2-Searchainaf-79544" , n);
    //% "%1. Search in %n items?"
    //@ Dialog2
    qtTrId("Dialog2-f1oa-85018" , n);
    //% "Age: %1"
    //@ Dialog2
    qtTrId("Dialog2-Age{af1");
    //% "There are %n house(s)"
    //@ Dialog2
    qtTrId("Dialog2-Thereaareaf-89651" , getCount());
    //% "Plurals and function call"
    //@ translate: There are %n house(s)
    qtTrId("translate: There are %n house(s)-Pluralsaanda-51377" , getCount());
    //% "%n house(s)"
    //@ Plurals, QCoreApplication
    qtTrId("Plurals, QCoreApplication-fna-61606" , n);
    //% "%n car(s)"
    //@ Plurals, QCoreApplication
    qtTrId("Plurals, QCoreApplication-fna-26815" , 1);
    //% "%n horse(s)"
    //@ Plurals, QCoreApplication
    qtTrId("Plurals, QCoreApplication-fna-56748" , getCount());
    QTranslator trans;
    //% "Simple"
    //@ QTranslator
    qtTrId("QTranslator-Simple");
    //% "Simple"
    //@ QTranslator
    qtTrId("QTranslator-Simple");
    //% "Simple with comment"
    //@ QTranslator
    qtTrId("QTranslator-Simpleawitha-70311");
    //% "Plural without comment"
    //@ QTranslator
    qtTrId("QTranslator-Pluralawithouta-57919" , 1);
    //% "Plural with comment"
    //@ QTranslator
    qtTrId("QTranslator-Pluralawitha-83843" , n);
    //% "Plural with comment"
    //@ QTranslator
    qtTrId("QTranslator-Pluralawitha-32045" , getCount());
    //% "Plural with comment and static cast"
    //@ QTranslator
    qtTrId("QTranslator-Pluralawitha-12749" , static_cast<long>(getCount()));
}

