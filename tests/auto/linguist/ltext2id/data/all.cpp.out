class ListInitializationClass : public NameSchpace::YetMoreFun, Gui::BaseClass
{
    Q_OBJECT

    ListInitializationClass()
        : NameSchpace::YetMoreFun(), 
        Gui::BaseClass{}, 
        a{ 0 }, 
        b(1), 
        //% "Hello World"
        //@ ListInitializationClass
        c(qtTrId("ListInitializationClass-HelloaWorld"))
    {
        //% "ListInitializationClass in-class constructor"
        //@ ListInitializationClass
        qtTrId("ListInitializationClass-ListInitializationClassainn-25559");
    }

    ListInitializationClass(int a);

    ListInitializationClass(int a, int b, int c);

    int a;
    int b;
    QString c;
};

ListInitializationClass::ListInitializationClass(int a) // :
//    b{ { 2, 3 }}[a]
{
    //% "ListInitializationClass out-of-class single member initializer"
    //@ ListInitializationClass
    qtTrId("ListInitializationClass-ListInitializationClassaoutn-70249");
}

ListInitializationClass::ListInitializationClass(int a, int b, int c)
    : NameSchpace::YetMoreFun{},
      Gui::BaseClass(),
      a{ 2 + (a / 3) },
      b(b),
      //% "%n item(s)"
      //@ ListInitializationClass
      c{ qtTrId("ListInitializationClass-fna-80040" , c) }
{
    //% "ListInitializationClass out-of-class multi member initializer"
    //@ ListInitializationClass
    qtTrId("ListInitializationClass-ListInitializationClassaoutn-1547");
}

class LambdaMemberClass : public Gui::BaseClass
{
    Q_OBJECT

    LambdaMemberClass()
        : Gui::BaseClass(),
          a{ []() { /*std::cout << */
                    //% "Hello"
                    //@ QObject
                    qtTrId("QObject-Hello");
          } },
          b([]() { /*std::cout << "World\n";*/ })
    {
        //% "LambdaMemberClass in-class constructor"
        //@ LambdaMemberClass
        qtTrId("LambdaMemberClass-LambdaMemberClassainn-13046");
    }

    LambdaMemberClass(void *);

    std::function<void()> a;
    std::function<void()> b;
};

LambdaMemberClass::LambdaMemberClass(void *)
    : Gui::BaseClass{},
      a([]() { /*std::cout <<*/
               //% "Hallo "
               //@ QObject
               qtTrId("QObject-Halloa ");
      }),
      b{ []() { /*std::cout << "Welt\n";*/ } }
{
    //% "LambdaMemberClass out-of-class constructor"
    //@ LambdaMemberClass
    qtTrId("LambdaMemberClass-LambdaMemberClassaoutn-23253");
}

// Template parameters in base class initialization
class TemplateClass : QVarLengthArray<char, sizeof(std::size_t)>, std::vector<int>
{
    Q_DECLARE_TR_FUNCTIONS(TemplateClass)
    QString member;

public:
    TemplateClass()
        : QVarLengthArray<char, sizeof(std::size_t)>(),
          std::vector<int>(3),
          //% "TemplateClass() in-class member initialization"
          //@ TemplateClass
          member(qtTrId("TemplateClass-TemplateClassijainn-2032"))
    {
        //% "TemplateClass() in-class body"
        //@ TemplateClass
        qtTrId("TemplateClass-TemplateClassijainn-56106");
    }

    TemplateClass(void *);
    TemplateClass(int);
};

TemplateClass::TemplateClass(void *)
    : QVarLengthArray<char, sizeof(std::size_t)>(),
      std::vector<int>{ 1, 2 },
      //% "TemplateClass(void *) out-of-class member initialization"
      //@ TemplateClass
      member{ qtTrId("TemplateClass-TemplateClassivoidakja-22839") }
{
    //% "TemplateClass(void *) out-of-class body"
    //@ TemplateClass
    qtTrId("TemplateClass-TemplateClassivoidakja-27846");
}

void ternary()
{
    const auto aaa = true ?
                          //: comment, aaa, true
            //% "ternary, true, aaa"
            //@ QObject
            qtTrId("QObject-ternarymatruema-96134")
                          //% "ternary, failure, aaa"
                          //@ QObject
                          : qtTrId("QObject-ternarymafailurema-61222");

    const auto bbb = true ?
                          //: comment, bbb, true
            //% "ternary, bbb, true"
            //@ QObject
            qtTrId("QObject-ternarymabbbma-71757")
                          :
                          //: comment, bbb, false
            //% "ternary, bbb, false"
            //@ QObject
            qtTrId("QObject-ternarymabbbma-60393");

    //% "ternary, fff, true"
    //@ QObject
    const auto ccc = true ? qtTrId("QObject-ternarymafffma-40748"): //% "ternary, fff, false"
//@ QObject
qtTrId("QObject-ternarymafffma-64929");
}

