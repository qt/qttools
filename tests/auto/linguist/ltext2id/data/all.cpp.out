void observedBugs() {
     m_includeOldEntriesAction->setToolTip(
                //% "Include branches and tags that have not been active for %n days."
                //@ QtC::Help
                qtTrId("QtC::Help-Includeabranchesa-664" , Constants::OBSOLETE_COMMIT_AGE_IN_DAYS));

     //% "[Only %n MB of output shown]"
